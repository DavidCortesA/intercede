# Copia este archivo a .env.local y completa los valores. Nunca versiones .env.local.
# Las variables sin prefijo NEXT_PUBLIC_ son SOLO de servidor.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Correo de contacto real que se muestra en el pie. Si está vacío, no se muestra el enlace.
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase (Fase 2)
NEXT_PUBLIC_SUPABASE_URL=
# Clave publishable (antes "anon key"). Es pública por diseño; la seguridad vive en RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # solo servidor

# LiveKit (Fase 4)
LIVEKIT_URL=
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=                   # solo servidor

# Web Push (Fase 6). Par nuevo: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                    # solo servidor (y secreto de la Edge Function)
VAPID_SUBJECT=                        # mailto:... o https://...

# Solo para la Edge Function dispatch-notifications (se definen con `supabase secrets set`, ver
# docs/operaciones/avisos.md; no los usa la app Next.js):
# DISPATCH_SECRET=                    # el mismo valor va en Vault como dispatcher_secret
# RESEND_FROM=                        # remitente de un dominio verificado, p. ej. INTERCEDE <avisos@tudominio.com>

# Correo y errores (Fase 6 y 8)
RESEND_API_KEY=
# Opcional: sin DSN, Sentry está apagado (privacidad: ver docs/decisions/0012)
SENTRY_DSN=

# CAPTCHA opcional (Fase 8): clave de SITIO de Cloudflare Turnstile. La secreta se configura en Supabase Auth, no aquí.
# Con esta variable, Auth debe tener CAPTCHA activo; sin ella no se carga ningún script de terceros.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Auth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=                 # solo servidor
# "Continuar con Google" solo se muestra con 1, cuando el proveedor ya está activo en Supabase
# (Authentication → Providers → Google; URI de redirección en Google Cloud:
# https://<ref>.supabase.co/auth/v1/callback).
NEXT_PUBLIC_GOOGLE_AUTH=