# Copia este archivo a .env.local y completa los valores. Nunca versiones .env.local.
# Las variables sin prefijo NEXT_PUBLIC_ son SOLO de servidor.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Fase 2)
NEXT_PUBLIC_SUPABASE_URL=
# Clave publishable (antes "anon key"). Es pública por diseño; la seguridad vive en RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # solo servidor

# LiveKit (Fase 4)
LIVEKIT_URL=
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=                   # solo servidor

# Web Push (Fase 6)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                    # solo servidor
VAPID_SUBJECT=

# Correo y errores (Fase 6 y 8)
RESEND_API_KEY=
SENTRY_DSN=
