# Copia este archivo a .env.local y completa los valores. Nunca versiones .env.local.
# Las variables sin prefijo NEXT_PUBLIC_ son SOLO de servidor.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Correo de contacto real que se muestra en el pie. Si está vacío, no se muestra el enlace.
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase (Fase 2)
NEXT_PUBLIC_SUPABASE_URL=
# Clave publishable (antes "anon key"). Es pública por diseño; la seguridad vive en RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # solo servidor

# LiveKit (Fase 4)
LIVEKIT_URL=
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=                   # solo servidor

# Web Push (Fase 6)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                    # solo servidor
VAPID_SUBJECT=

# Correo y errores (Fase 6 y 8)
RESEND_API_KEY=
SENTRY_DSN=

# Google Auth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=                 # solo servidor
# "Continuar con Google" solo se muestra con 1, cuando el proveedor ya está activo en Supabase
# (Authentication → Providers → Google; URI de redirección en Google Cloud:
# https://<ref>.supabase.co/auth/v1/callback).
NEXT_PUBLIC_GOOGLE_AUTH=